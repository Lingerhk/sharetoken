# Settings of docker-compose.yml. Copy to .env and fill in; .env is not committed.

# MySQL: the sharetoken account's password, and root's. Use long random values.
DB_PASSWORD=
DB_ROOT_PASSWORD=

# The address clients reach this machine at: an IP address or a DNS name.
# The relay announces it and the portal's self-signed certificate is issued
# for it. 127.0.0.1 only works for clients on this machine.
PUBLIC_HOST=127.0.0.1

# Published ports. The relay's port is also the one it announces.
PORTAL_PORT=8092
PORTAL_BIND=0.0.0.0
RELAY_PORT=4001

# Portal TLS: auto (self-signed certificate, clients pin its fingerprint),
# or proxy when a reverse proxy terminates TLS in front of it.
PORTAL_TLS_MODE=auto

# Who the portal's mail comes from. People sign in with a code mailed to them,
# so without a sender and a mail server delivering (docs/mail.md; this Compose
# file does not start one) nobody can sign in.
MAIL_FROM=
MAIL_SUPPORT=

# Accounts: let anyone sign up, and the micro-credits a new user starts with
# (1 credit = 1000000 micro-credits).
OPEN_REGISTRATION=true
SIGNUP_CREDIT_MICROS=5000000

# The first administrator's email address: the account is created when this is
# set. Administrators sign in with a mailed code and a second factor, set up on
# the first sign-in.
ADMIN_EMAIL=

# The platform's cut of each job, in basis points (500 = 5%).
FEE_BPS=500
