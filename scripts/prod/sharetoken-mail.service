[Unit]
Description=sharetoken mail server
After=network-online.target docker.service sharetoken-portal.service
Wants=network-online.target

[Service]
User=s0nnet
WorkingDirectory=/home/s0nnet/sharetoken-prod
Environment=GOMEMLIMIT=256MiB
ExecStartPre=/bin/bash -c 'for i in $(seq 60); do (echo > /dev/tcp/127.0.0.1/3306) 2>/dev/null && exit 0; sleep 2; done; exit 1'
ExecStart=/home/s0nnet/sharetoken-prod/mailserver -config mail.yaml serve
Restart=always
RestartSec=5
LimitNOFILE=4096
# Binds port 25 without running as root, and can do nothing else privileged.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=400M

[Install]
WantedBy=multi-user.target
