[Unit]
Description=sharetoken coordinator
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=s0nnet
WorkingDirectory=/home/s0nnet/sharetoken-prod
ExecStartPre=/bin/bash -c 'for i in $(seq 60); do (echo > /dev/tcp/127.0.0.1/3306) 2>/dev/null && exit 0; sleep 2; done; exit 1'
ExecStart=/home/s0nnet/sharetoken-prod/coordinator -config coordinator.yaml
Restart=always
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
