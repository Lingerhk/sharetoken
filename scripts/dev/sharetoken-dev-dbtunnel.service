[Unit]
Description=sharetoken dev: SSH tunnel to the MySQL instance on armbian
After=network-online.target
Wants=network-online.target

[Service]
User=st-dbtunnel
Group=st-dbtunnel
# The key may only forward to 127.0.0.1:3306 there and run no command (authorized_keys: command=,restrict,port-forwarding,permitopen).
# Key and known_hosts live in /etc/sharetoken-dev/dbtunnel; the user's home (/var/lib/sharetoken-dev/dbtunnel) is for ssh's own files.
ExecStart=/usr/bin/ssh -N -i /etc/sharetoken-dev/dbtunnel/dbtunnel.key -o IdentitiesOnly=yes -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=3 -o UserKnownHostsFile=/etc/sharetoken-dev/dbtunnel/dbtunnel.known_hosts -o StrictHostKeyChecking=yes -L 127.0.0.1:3306:127.0.0.1:3306 s0nnet@192.168.6.91
Restart=always
RestartSec=5
StateDirectory=sharetoken-dev/dbtunnel
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# 加固：只读的系统，看不到 /home，没有任何 capability，只允许普通服务的系统调用
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=multi-user.target
