[Unit]
Description=sharetoken dev: SSH tunnel to the MySQL instance on armbian
After=network-online.target
Wants=network-online.target

[Service]
User=s0nnet
# The key may only forward to 127.0.0.1:3306 there and run no command (authorized_keys: command=,restrict,port-forwarding,permitopen).
ExecStart=/usr/bin/ssh -N -i /home/s0nnet/sharetoken-dev/dbtunnel.key -o IdentitiesOnly=yes -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=3 -o UserKnownHostsFile=/home/s0nnet/sharetoken-dev/dbtunnel.known_hosts -o StrictHostKeyChecking=yes -L 127.0.0.1:3306:127.0.0.1:3306 s0nnet@192.168.6.91
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
