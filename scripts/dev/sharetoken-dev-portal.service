[Unit]
Description=sharetoken dev portal
After=network-online.target docker.service sharetoken-dev-coordinator.service
Wants=network-online.target

[Service]
User=st-portal
Group=st-portal
# 配置和机密在 /etc/sharetoken-dev/portal（root:st-portal 0750）；唯一可写目录是 /var/lib/sharetoken-dev/portal（下载区）
WorkingDirectory=/etc/sharetoken-dev/portal
StateDirectory=sharetoken-dev/portal
Environment=GOMEMLIMIT=100MiB
ExecStartPre=/bin/bash -c 'for i in $(seq 60); do (echo > /dev/tcp/127.0.0.1/3306) 2>/dev/null && exit 0; sleep 2; done; exit 1'
ExecStart=/srv/sharetoken-dev/portal -config /etc/sharetoken-dev/portal/portal.yaml serve
Restart=always
RestartSec=5
LimitNOFILE=8192
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# 加固：只读的系统，看不到 /home，没有任何 capability，只允许普通服务的系统调用
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077
# This machine (nginx, MySQL), plus SSH to the relays for their metrics (portal.yaml relay_metrics).
IPAddressDeny=any
IPAddressAllow=localhost
IPAddressAllow=165.227.115.27 201.79.122.100 164.92.157.227 119.29.250.173 101.43.2.87
MemoryHigh=150M
MemoryMax=200M

[Install]
WantedBy=multi-user.target
