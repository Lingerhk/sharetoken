[Unit]
Description=sharetoken dev mail server
After=network-online.target docker.service sharetoken-dev-portal.service
Wants=network-online.target

[Service]
User=st-mail
Group=st-mail
# 配置和机密在 /etc/sharetoken-dev/mail（root:st-mail 0750）；证书由 certbot 钩子复制到 tls/；邮件服务不写磁盘
WorkingDirectory=/etc/sharetoken-dev/mail
Environment=GOMEMLIMIT=64MiB
ExecStartPre=/bin/bash -c 'for i in $(seq 60); do (echo > /dev/tcp/127.0.0.1/3306) 2>/dev/null && exit 0; sleep 2; done; exit 1'
ExecStart=/srv/sharetoken-dev/mailserver -config /etc/sharetoken-dev/mail/mail.yaml serve
Restart=always
RestartSec=5
LimitNOFILE=4096
# Binds port 25 without running as root, and can do nothing else privileged.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# 加固：只读的系统，看不到 /home，没有任何 capability，只允许普通服务的系统调用
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=multi-user.target
