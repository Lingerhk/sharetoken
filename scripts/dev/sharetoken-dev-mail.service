[Unit]
Description=sharetoken dev mail server
After=network-online.target sharetoken-dev-dbtunnel.service sharetoken-dev-portal.service
Wants=network-online.target sharetoken-dev-dbtunnel.service

[Service]
User=s0nnet
WorkingDirectory=/home/s0nnet/sharetoken-dev
Environment=GOMEMLIMIT=64MiB
ExecStartPre=/bin/bash -c 'for i in $(seq 60); do (echo > /dev/tcp/127.0.0.1/3306) 2>/dev/null && exit 0; sleep 2; done; exit 1'
ExecStart=/home/s0nnet/sharetoken-dev/mailserver -config mail.yaml serve
Restart=always
RestartSec=5
# Binds port 25 without running as root, and can do nothing else privileged.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
